#!/usr/bin/env python3
# tb-adb — lista TBs NovaStar (Taurus) e liga/desliga o ADB, sem ViPlex.
# Fluxo: login REST (16674) -> habilita SSH (dropbear:1212) -> ssh root -> setprop adbd.
# Linux/macOS: usa o ssh do sistema. Windows: usa paramiko<4 (pip install "paramiko<4").
import sys, os, re, json, ssl, socket, shutil, subprocess, urllib.request, urllib.error, http.client
import time, argparse, tempfile, contextlib

CFG_DIR  = os.path.expanduser("~/.config/tb-adb")
REG_FILE = os.path.join(CFG_DIR, "devices.json")
API_PORT = 16674
API_WAIT = 120               # s esperando o servico da TB subir (logo apos o boot ele recusa/derruba conexoes)
SSH_PORT = 1212
DEF_USER = "admin"
DEF_PASS = "123456"          # senha de login/SSH (confirmada na TB2)
ADB_PORT = 5555
# Protocolo de busca do ViPlex: UDP, pedido de 24 bytes em broadcast/unicast p/ 16601 e 16611.
# A TB responde por unicast, com um cabecalho de 24 bytes + JSON (SN, nome, modelo, tela...).
AVON_REQUEST = bytes.fromhex("41564f4effffffff55888100010000000000000000008f00")
AVON_UNICAST_PORT = 16601
AVON_PORTS = (16601, 16611)
DEEP_TCP_TIMEOUT = 1.5
DEEP_TCP_TRIES = 2
SSH_OPTS = [
    "-p", str(SSH_PORT),
    "-o","StrictHostKeyChecking=no","-o",f"UserKnownHostsFile={os.devnull}",
    "-o","KexAlgorithms=diffie-hellman-group14-sha1",   # dropbear c/ ecdsa quebrado -> forcar
    "-o","HostKeyAlgorithms=ssh-rsa","-o","Ciphers=aes128-ctr",
    "-o","PubkeyAuthentication=no","-o","PreferredAuthentications=password",
    "-o","NumberOfPasswordPrompts=1","-o","ConnectTimeout=8","-o","LogLevel=ERROR",
]
C = dict(g="\033[32m", r="\033[31m", y="\033[33m", b="\033[34m", d="\033[2m", n="\033[0m", bold="\033[1m")
if os.name=="nt": os.system("")   # liga as cores ANSI no console do Windows

def migrate_registry(old):
    """Converte o cadastro antigo (chave = IP) para o v2 (chave = SN). Pura: nao le nem
    grava arquivo. Agrupa por SN; entre entradas com o mesmo SN, uma 192.168.* vence uma
    192.169.* (a TB por USB troca de IP 192.169.x.x a cada conexao); last_ip so vem de
    uma 192.168.*. Se ja for v2, devolve como esta."""
    if isinstance(old, dict) and old.get("version") == 2 and isinstance(old.get("devices"), dict):
        return old
    devices = {}
    for ip, d in (old or {}).items():
        if not isinstance(d, dict): continue
        sn = d.get("sn")
        if not sn: continue
        e = devices.setdefault(sn, {})
        is_168 = ip.startswith("192.168.")
        for field in ("password", "ssh_password", "name"):
            if d.get(field) and (field not in e or is_168):
                e[field] = d[field]
        if is_168:
            e["last_ip"] = ip
    return {"version": 2, "devices": devices}

def load_reg():
    try:
        with open(REG_FILE) as f: raw=json.load(f)
    except Exception: raw={}
    if not isinstance(raw, dict): raw={}
    return migrate_registry(raw)

def save_reg(reg):
    os.makedirs(CFG_DIR, exist_ok=True)
    # migracao: so grava o formato novo depois de uma operacao que ja ia salvar, e faz
    # um backup do arquivo antigo (uma vez so) antes de sobrescrever
    if os.path.exists(REG_FILE):
        try:
            with open(REG_FILE) as f: cur=json.load(f)
        except Exception: cur=None
        bak=REG_FILE+".bak"
        if isinstance(cur,dict) and cur.get("version")!=2 and not os.path.exists(bak):
            shutil.copyfile(REG_FILE, bak)
    with open(REG_FILE,"w") as f: json.dump(reg,f,indent=2)

def get_device(reg, sn):
    return reg["devices"].get(sn, {})

def set_device(reg, sn, **fields):
    d=reg["devices"].setdefault(sn, {})
    d.update({k:v for k,v in fields.items() if v})
    reg["devices"][sn]=d
    save_reg(reg)
    return d

def tcp_open(ip, port, t=1.0):
    s=socket.socket(); s.settimeout(t)
    try: return s.connect_ex((ip,port))==0
    finally: s.close()

def _ctx():
    c=ssl.create_default_context(); c.check_hostname=False; c.verify_mode=ssl.CERT_NONE; return c

def api(ip, path, method, token=None, body=None, t=10):
    url=f"https://{ip}:{API_PORT}/terminal/core/v1/{path}"
    data=json.dumps(body).encode() if body is not None else None
    req=urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type","application/json")
    if token: req.add_header("Authorization", token)
    with urllib.request.urlopen(req, context=_ctx(), timeout=t) as r:
        return json.loads(r.read().decode())

class AuthError(RuntimeError):
    """SN ou senha rejeitados pela TB (a API respondeu 200 com code != 0, ex.: 'sn not
    match'). Diferente de erro de rede/timeout, para o loop de senhas em ensure_device
    saber que deve tentar a proxima candidata em vez de abortar."""

def login(ip, sn, pw=DEF_PASS):
    r=api(ip,"login","POST",body={
        "sn":sn,"username":DEF_USER,"password":pw,
        "clientId":os.urandom(16).hex(),"clientName":"tb-adb","loginType":9,
        "source":{"type":0,"platform":2,"platformVersion":"3.0.5"}})
    if r.get("code")!=0: raise AuthError(r.get("message","login falhou"))
    return r["data"]["token"]

def login_wait(ip, sn, pw=DEF_PASS, wait=API_WAIT):
    # Logo apos a TB ligar/reiniciar, a 16674 passa 1-2 min recusando conexao, aceitando
    # e travando o TLS, ou resetando. So erro de rede e repetido; senha/SN errado falha na hora.
    t0=time.time(); avisou=False
    while True:
        try:
            tok=login(ip, sn, pw)
            if avisou: print(f"  servico no ar ({int(time.time()-t0)}s)", flush=True)
            return tok
        except urllib.error.HTTPError: raise
        except (OSError, http.client.HTTPException) as e:
            motivo=getattr(e,"reason",e)
            if time.time()-t0 >= wait:
                raise RuntimeError(f"servico da TB em {ip}:{API_PORT} nao respondeu em {wait}s ({motivo}). "
                                   "A TB esta ligada e na mesma rede?") from None
            if not avisou:
                print(f"  {C['y']}servico da TB ainda nao respondeu ({motivo}); "
                      f"aguardando ate {wait}s (Ctrl+C cancela)...{C['n']}", flush=True)
                avisou=True
            time.sleep(3)

def _ssh_svc(ip, token, state):
    r=api(ip,"ssh/service/status","POST",token=token,
          body={"serviceStatus":[{"state":state,"type":"SSH","persisted":False}]})
    if r.get("code")!=0: raise RuntimeError("ssh service: "+r.get("message",""))

def enable_ssh(ip, token):
    # Ciclo OFF->ON e ESSENCIAL: apos um reboot da TB o dropbear sobe num estado
    # em que a auth por senha falha; so mandar state=1 nao reseta. Desligar (0) e
    # religar (1) faz o dropbear reiniciar limpo e aceitar admin/123456.
    try: _ssh_svc(ip, token, 0)
    except Exception: pass
    time.sleep(2)
    _ssh_svc(ip, token, 1)
    for _ in range(15):
        if tcp_open(ip, SSH_PORT): return True
        time.sleep(1)
    raise RuntimeError("SSH nao subiu na 1212")

# ---------- ssh ----------
def _ssh_backend():
    # TB_ADB_SSH=openssh|paramiko forca um dos dois (util p/ testar o caminho do Windows no Linux)
    b=os.environ.get("TB_ADB_SSH")
    if b: return b
    return "openssh" if os.name!="nt" and shutil.which("ssh") else "paramiko"

@contextlib.contextmanager
def _askpass_env(pw):
    # ssh do sistema le a senha deste helper (SSH_ASKPASS), sem precisar de sshpass
    os.makedirs(CFG_DIR, exist_ok=True)
    ap=tempfile.NamedTemporaryFile("w",suffix=".sh",delete=False,dir=CFG_DIR)
    ap.write('#!/bin/sh\necho "$TB_PW"\n'); ap.close(); os.chmod(ap.name,0o700)
    try: yield dict(os.environ, TB_PW=pw, SSH_ASKPASS=ap.name, SSH_ASKPASS_REQUIRE="force", DISPLAY=os.environ.get("DISPLAY",":0"))
    finally:
        try: os.unlink(ap.name)
        except Exception: pass

def _ssh_run_openssh(ip, cmd, pw):
    with _askpass_env(pw) as env:
        # start_new_session (= setsid): sem tty de controle o ssh nunca pede senha no terminal
        p=subprocess.run(["ssh",*SSH_OPTS,f"{DEF_USER}@{ip}",cmd], env=env, stdin=subprocess.DEVNULL,
                         capture_output=True, text=True, timeout=25, start_new_session=True)
        return p.returncode, p.stdout, p.stderr

def _ssh_run_paramiko(ip, cmd, pw):
    import warnings
    try:
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")   # cryptography avisa sobre algoritmos antigos
            import paramiko
    except ImportError:
        raise RuntimeError('sem o ssh do sistema, o tb-adb precisa do paramiko: pip install "paramiko<4"') from None
    # paramiko>=4 removeu ssh-rsa (SHA-1), a unica host key que funciona no dropbear da TB
    if "ssh-rsa" not in getattr(paramiko.Transport,"_key_info",{}):
        raise RuntimeError(f'paramiko {paramiko.__version__} nao suporta ssh-rsa, exigido pela TB: pip install "paramiko<4"')
    t=paramiko.Transport(socket.create_connection((ip,SSH_PORT),timeout=8))
    try:
        o=t.get_security_options()   # mesmos algoritmos forcados em SSH_OPTS
        o.kex=("diffie-hellman-group14-sha1",); o.key_types=("ssh-rsa",); o.ciphers=("aes128-ctr",)
        t.start_client(timeout=10)
        try: t.auth_password(DEF_USER, pw)
        except paramiko.AuthenticationException as e: return 255, "", f"auth falhou: {e}"
        ch=t.open_session(timeout=10); ch.settimeout(25); ch.exec_command(cmd)
        out=ch.makefile("rb").read().decode(errors="replace")
        err=ch.makefile_stderr("rb").read().decode(errors="replace")
        return ch.recv_exit_status(), out, err
    finally: t.close()

def ssh_run(ip, cmd, pw=DEF_PASS):
    return (_ssh_run_paramiko if _ssh_backend()=="paramiko" else _ssh_run_openssh)(ip, cmd, pw)

def ssh_interactive(ip, pw, cmd=None):
    if not shutil.which("ssh"):
        if cmd is None: raise RuntimeError("shell interativo precisa do cliente OpenSSH (ssh) instalado")
        rc,out,err=ssh_run(ip,cmd,pw); sys.stdout.write(out); sys.stderr.write(err); return rc
    args=["ssh","-t" if sys.stdin.isatty() else "-T",*SSH_OPTS,f"{DEF_USER}@{ip}"]+([cmd] if cmd else [])
    if os.name=="nt":
        # no Windows o ssh.exe nao tem SSH_ASKPASS confiavel: a senha e digitada
        print(f"  senha SSH: {pw}")
        return subprocess.run(args).returncode
    with _askpass_env(pw) as env: return subprocess.run(args, env=env).returncode

def get_sn_via_ssh(ip, pw=DEF_PASS):
    rc,out,_=ssh_run(ip,"getprop ro.serialno 2>/dev/null || getprop ro.boot.serialno",pw)
    return out.strip() if rc==0 and out.strip() else None

# ---------- descoberta ----------
IPV4=re.compile(r"\d{1,3}(?:\.\d{1,3}){3}")

def _out(cmd):
    try: return subprocess.run(cmd,capture_output=True,timeout=5).stdout.decode(errors="replace")
    except Exception: return ""

# Cada _net_* devolve (gateways padrao, bases das redes /24 locais, IPs locais desta
# maquina), a partir da saida dos comandos de rede do SO. A TB ligada por USB vira o
# gateway da interface USB (192.168.42.129).
def _net_linux(routes, addrs):
    gws={p[p.index("via")+1] for p in map(str.split,routes.splitlines()) if "default" in p and "via" in p}
    locais={l.split()[3].split("/")[0] for l in addrs.splitlines() if " scope global" in l and "/24" in l}
    bases=[ip.rsplit(".",1)[0] for ip in locais]
    return gws, bases, locais

def _net_mac(routes, ifconfig):
    gws={p[1] for p in map(str.split,routes.splitlines()) if len(p)>1 and p[0]=="default" and IPV4.fullmatch(p[1])}
    locais={p[1] for p in map(str.split,ifconfig.splitlines())
            if len(p)>3 and p[0]=="inet" and p[2]=="netmask" and p[3]=="0xffffff00"}
    bases=[ip.rsplit(".",1)[0] for ip in locais]
    return gws, bases, locais

def _net_win(routes):
    # 'route print -4': so os IPs de cada linha importam ('On-link'/'No vinculo' mudam com o idioma)
    gws,bases,locais=set(),[],set()
    for l in routes.splitlines():
        ips=IPV4.findall(l)
        if len(ips)>=3 and ips[0]==ips[1]=="0.0.0.0": gws.add(ips[2])
        elif len(ips)==3 and ips[1]=="255.255.255.0" and not ips[2].startswith(("127.","169.254.")):
            bases.append(ips[2].rsplit(".",1)[0]); locais.add(ips[2])
    return gws, bases, locais

def _local_ips_fallback():
    # Complementa o que os parsers acima acharem: portatil, sem depender do formato de
    # saida de nenhum comando (util sobretudo se o parser do SO nao pegar alguma interface).
    try:
        return set(socket.gethostbyname_ex(socket.gethostname())[2])
    except Exception:
        return set()

def net_info():
    if sys.platform=="darwin":
        gws,bases,locais=_net_mac(_out(["netstat","-rn","-f","inet"]), _out(["ifconfig"]))
    elif os.name=="nt":
        gws,bases,locais=_net_win(_out(["route","print","-4"]))
    else:
        gws,bases,locais=_net_linux(_out(["ip","-o","-4","route","show"]), _out(["ip","-o","-4","addr","show"]))
    return gws, bases, locais|_local_ips_fallback()

def parse_avon(data):
    """Decodifica uma resposta do protocolo de busca do ViPlex (AVON, UDP). Cabecalho de
    24 bytes (AVON/ffffffff/5588/0100/00000000 + tamanho do JSON em 4 bytes LE + 4 bytes
    ignorados) seguido do JSON. Devolve o dict do JSON, ou None se invalido."""
    if len(data) < 24: return None
    if (data[0:4]!=b"AVON" or data[4:8]!=b"\xff\xff\xff\xff" or data[8:10]!=b"\x55\x88"
            or data[10:12]!=b"\x01\x00" or data[12:16]!=b"\x00\x00\x00\x00"):
        return None
    n=int.from_bytes(data[16:20],"little")
    if n<=0 or 24+n>len(data): return None
    try: return json.loads(data[24:24+n].decode("utf-8"))
    except Exception: return None

def drop_self(found, local_ips):
    """Remove do resultado da busca respostas vindas dos proprios IPv4 desta maquina
    (funcao pura)."""
    return {ip: info for ip, info in found.items() if ip not in local_ips}

def discover_udp(cands, rounds=3, wait=2.0, local_ips=frozenset()):
    """Manda AVON_REQUEST em unicast (16601) para cada candidato e em broadcast (16601 e
    16611) para 255.255.255.255 e o .255 de cada /24 representada em cands, por `rounds`
    vezes, e coleta as respostas por ate `wait` s depois do ultimo envio.

    sendto pode bloquear enquanto o ARP resolve (por isso um socket bloqueante para
    enviar, sem timeout, ignorando o OSError de cada envio - o timeout so entra na hora
    de receber). Um UDP socket so' bloqueia por causa do ARP no host que o esta usando
    *naquele momento*: threads concorrentes que dividem um UNICO socket serializam esse
    bloqueio (medido: ~3s pra 254 IPs, quase igual ao envio serial). Por isso cada thread
    do pool usa seu proprio socket (thread-local); todos ficam abertos ate o fim do
    `wait`, porque a TB responde pro IP:porta exatos de quem mandou o pedido. `local_ips`
    filtra respostas vindas desta propria maquina."""
    import threading, selectors
    from concurrent.futures import ThreadPoolExecutor
    cands=list(cands)
    bcasts={"255.255.255.255"} | {ip.rsplit(".",1)[0]+".255" for ip in cands}
    n_workers=min(64, max(1,len(cands)))
    tls=threading.local(); socks=[]; lock=threading.Lock()
    def send_unicast(ip):
        s=getattr(tls,"s",None)
        if s is None:
            s=socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            tls.s=s
            with lock: socks.append(s)
        try: s.sendto(AVON_REQUEST, (ip, AVON_UNICAST_PORT))
        except OSError: pass
    bsock=socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    bsock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    found={}
    try:
        with ThreadPoolExecutor(n_workers) as ex:
            for i in range(rounds):
                list(ex.map(send_unicast, cands))
                for bc in bcasts:
                    for port in AVON_PORTS:
                        try: bsock.sendto(AVON_REQUEST, (bc, port))
                        except OSError: pass
                if i < rounds-1: time.sleep(0.3)
        all_socks=socks+[bsock]
        with selectors.DefaultSelector() as sel:
            for s in all_socks:
                s.setblocking(False); sel.register(s, selectors.EVENT_READ)
            t0=time.time()
            while True:
                restante=wait-(time.time()-t0)
                if restante<=0: break
                for key,_ in sel.select(timeout=min(restante,0.5)):
                    try: data,addr=key.fileobj.recvfrom(65535)
                    except OSError: continue
                    info=parse_avon(data)
                    if info: found[addr[0]]=info
    finally:
        for s in socks+[bsock]:
            try: s.close()
            except OSError: pass
    return drop_self(found, local_ips)

def discover(deep=False):
    """Acha TBs como o ViPlex: busca UDP (padrao) em gateways + IPs cadastrados + todas as
    sub-redes /24 locais. Uma TB que nao responder ao UDP ainda pode ser achada por TCP na
    16674 (so com --deep, porque a varredura completa demora mais)."""
    reg=load_reg()
    gws,bases,local_ips=net_info()
    last_ips={d["last_ip"] for d in reg["devices"].values() if d.get("last_ip")}
    cands=set(gws) | last_ips
    for base in bases:
        cands|={f"{base}.{i}" for i in range(1,255)}
    found={ip:dict(info, via="udp") for ip,info in discover_udp(cands, rounds=3, wait=2.0, local_ips=local_ips).items()}
    if deep:
        from concurrent.futures import ThreadPoolExecutor
        missing=cands-set(found)
        def chk(ip):
            for _ in range(DEEP_TCP_TRIES):
                if tcp_open(ip,API_PORT,DEEP_TCP_TIMEOUT): return ip
            return None
        with ThreadPoolExecutor(128) as ex:
            for ip in ex.map(chk, missing):
                if ip: found[ip]={"via":"tcp"}
    return found, reg

def resolve_target(found, target):
    """Resolve um alvo de on/off/shell dentro do resultado da busca (funcao pura). Um IP e
    sempre aceito direto. SN e aliasName sao tentados por igualdade exata e, se nao achar,
    por sufixo (util p/ digitar so o fim do SN/nome). Ambiguo ou nao encontrado: erro
    listando os candidatos."""
    if IPV4.fullmatch(target): return target
    def cands_msg(ips):
        itens=[f"{ip} ({found[ip].get('sn','?')}, {found[ip].get('aliasName','?')})" for ip in sorted(ips)]
        return "; ".join(itens)
    exact=[ip for ip,info in found.items() if target in (info.get("sn"), info.get("aliasName"))]
    if len(exact)==1: return exact[0]
    if len(exact)>1: raise RuntimeError(f"alvo '{target}' ambiguo: {cands_msg(exact)}")
    suf=[ip for ip,info in found.items()
         if (info.get("sn") or "").endswith(target) or (info.get("aliasName") or "").endswith(target)]
    if len(suf)==1: return suf[0]
    if len(suf)>1: raise RuntimeError(f"alvo '{target}' ambiguo: {cands_msg(suf)}")
    disponiveis=cands_msg(found.keys()) if found else "nenhuma TB encontrada"
    raise RuntimeError(f"TB '{target}' nao encontrada. Disponiveis: {disponiveis}")

# ---------- acoes ----------
def probe_avon(ip, wait=1.5):
    """Manda AVON_REQUEST em unicast pra um unico IP (3 tentativas) e devolve a resposta,
    se houver. Usado para achar o SN/nome de uma TB sem pedir login."""
    return discover_udp({ip}, rounds=3, wait=wait).get(ip)

def ensure_device(ip, reg, wait=API_WAIT):
    """Garante que temos SN+senha do device e faz UM login (devolve token pra reusar,
    evitando logar de novo em seguida). O SN vem da busca UDP (sem login); so pergunta ao
    usuario se a TB nao responder. A senha tenta primeiro a do cadastro, depois a padrao,
    e so entao pergunta. SN/senha errados (AuthError/HTTPError) passam pra proxima
    candidata; erro de rede/timeout (RuntimeError comum, de login_wait) propaga na hora -
    nao adianta ciclar senha se a TB nem respondeu. Devolve (sn, device, token)."""
    info=probe_avon(ip)
    sn=info.get("sn") if info else None
    name=info.get("aliasName") if info else None
    if not sn:
        print(f"{C['y']}TB em {ip} nao respondeu a busca; digite os dados.{C['n']}")
        sn=input("  SN da TB (etiqueta do aparelho): ").strip()
    d=get_device(reg, sn)
    tentativas=[]
    if d.get("password"): tentativas.append(d["password"])
    if DEF_PASS not in tentativas: tentativas.append(DEF_PASS)
    pw=tok=None
    for cand in tentativas:
        try:
            tok=login_wait(ip, sn, cand, wait); pw=cand; break
        except (urllib.error.HTTPError, AuthError):
            continue
    if pw is None:
        pw=input(f"  senha [{DEF_PASS}]: ").strip() or DEF_PASS
        try:
            tok=login_wait(ip, sn, pw, wait); print(f"  {C['g']}ok, credenciais validas{C['n']}")
        except (urllib.error.HTTPError, AuthError) as e:
            raise RuntimeError(f"credenciais invalidas para {ip}: {e}") from None
    d=set_device(reg, sn, password=pw, name=d.get("name") or name, last_ip=ip)
    return sn, d, tok

def adb_status(ip):
    return "ligado" if tcp_open(ip,ADB_PORT,0.6) else "desligado"

def find_ssh_pw(ip, sn, reg, login_pw):
    # A senha do SSH pode diferir da de conexao: nos players rk356x/rk3328 (ex.: T40,
    # Android 11) o dropbear usa a fixa "novastar2008"; nos rk312x (ex.: T2) usa a de
    # conexao. Tenta na ordem e memoriza a que funciona.
    d=get_device(reg, sn); cands=[]
    if d.get("ssh_password"): cands.append(d["ssh_password"])
    cands += [login_pw, "novastar2008", DEF_PASS]
    seen=set()
    for p in cands:
        if not p or p in seen: continue
        seen.add(p)
        rc,out,_=ssh_run(ip,"echo OK", p)
        if rc==0 and "OK" in out:
            if d.get("ssh_password")!=p: set_device(reg, sn, ssh_password=p)
            return p
    raise RuntimeError("nenhuma senha SSH funcionou (tentei: %s)"%", ".join(seen))

def adb_set(ip, reg, on=True, wait=API_WAIT):
    print(f"  login em {ip}...", flush=True)
    sn,d,tok=ensure_device(ip,reg,wait); login_pw=d.get("password",DEF_PASS)
    print("  habilitando SSH...", flush=True); enable_ssh(ip,tok)
    sshpw=find_ssh_pw(ip, sn, reg, login_pw)
    if on:
        # sys.adbd.enable=1: portao da NovaStar no Android 11 (sem isso o adbd fecha
        # toda conexao com CLSE). Inofensivo em players que nao tem o portao.
        cmd=(f"setprop service.adb.tcp.port {ADB_PORT}; setprop persist.adb.tcp.port {ADB_PORT}; "
             f"setprop sys.adbd.enable 1; stop adbd; start adbd; echo done")
    else:
        cmd="setprop service.adb.tcp.port -1; setprop sys.adbd.enable 0; stop adbd; start adbd; echo done"
    print(f"  {'ligando' if on else 'desligando'} adb...", flush=True)
    rc,out,err=ssh_run(ip, cmd, sshpw)
    if rc!=0: raise RuntimeError(err.strip() or "ssh falhou")
    if on:
        for _ in range(8):
            if tcp_open(ip,ADB_PORT): break
            time.sleep(1)
    set_device(reg, sn, last_ip=ip)   # registra o IP que funcionou
    return adb_status(ip)

def do_connect(ip):
    if not shutil.which("adb"):
        print(f"  {C['y']}adb nao encontrado no PATH (instale o Android platform-tools){C['n']}"); return
    # descarta a conexao velha: depois de religar o adbd o "already connected" fica offline por uns segundos
    subprocess.run(["adb","disconnect",f"{ip}:{ADB_PORT}"],capture_output=True)
    subprocess.run(["adb","connect",f"{ip}:{ADB_PORT}"])

# ---------- UI ----------
def fmt_list(found):
    rows=[]
    for ip,info in sorted(found.items()):
        name=info.get("aliasName") or "(sem nome)"
        modelo=info.get("productName") or "?"
        plataforma=info.get("platform") or "?"
        sn=info.get("sn") or "?"
        w,h=info.get("width"),info.get("height")
        tela=f"{w}x{h}" if w and h else "?"
        st=adb_status(ip); col=C['g'] if st=="ligado" else C['d']
        rows.append((ip,name,modelo,plataforma,sn,tela,st,col))
    return rows

def cmd_list(deep=False):
    print(f"{C['d']}procurando TBs...{C['n']}")
    found,reg=discover(deep)
    if not found:
        print(f"{C['y']}nenhuma TB encontrada. (tente: tb-adb list --deep){C['n']}"); return found,reg
    print(f"\n{C['bold']}{'IP':<16}{'NOME':<20}{'MODELO':<12}{'PLATAFORMA':<12}{'SN':<22}{'TELA':<10}ADB{C['n']}")
    for ip,name,modelo,plataforma,sn,tela,st,col in fmt_list(found):
        print(f"{col}{ip:<16}{name:<20}{modelo:<12}{plataforma:<12}{sn:<22}{tela:<10}{st}{C['n']}")
    print()
    return found,reg

def menu():
    while True:
        found,reg=cmd_list()
        ips=sorted(found.keys())
        print(f"{C['bold']}acoes:{C['n']} [numero]=alternar adb  c=conectar adb  r=rescan  d=rescan profundo  q=sair")
        for i,ip in enumerate(ips): print(f"  {i+1}) {ip}")
        ch=input("> ").strip().lower()
        if ch=="q": break
        if ch=="r": continue
        if ch=="d": cmd_list(deep=True); input("enter..."); continue
        if ch=="c":
            for ip in ips: do_connect(ip)
            input("enter..."); continue
        if ch.isdigit() and 1<=int(ch)<=len(ips):
            ip=ips[int(ch)-1]; cur=adb_status(ip)
            try:
                new=adb_set(ip,reg,on=(cur!="ligado"))
                print(f"  {C['g']}adb agora: {new}{C['n']}")
                if new=="ligado": do_connect(ip)
            except Exception as e:
                print(f"  {C['r']}erro: {e}{C['n']}")
            input("enter...")

def resolve_ip(target, reg, wait=2.0):
    """Resolve um alvo (IP, SN, aliasName ou sufixo) pra um IP, buscando por UDP quando
    nao for um IP direto."""
    if IPV4.fullmatch(target): return target
    print(f"{C['d']}procurando '{target}'...{C['n']}")
    gws,bases,local_ips=net_info()
    last_ips={d["last_ip"] for d in reg["devices"].values() if d.get("last_ip")}
    cands=set(gws) | last_ips
    for base in bases:
        cands|={f"{base}.{i}" for i in range(1,255)}
    found=discover_udp(cands, rounds=3, wait=wait, local_ips=local_ips)
    return resolve_target(found, target)

def main():
    ap=argparse.ArgumentParser(prog="tb-adb", description="Lista TBs NovaStar e liga/desliga ADB (sem ViPlex)")
    sub=ap.add_subparsers(dest="cmd")
    sub.add_parser("list").add_argument("--deep",action="store_true")
    for name in ("on","off","shell"):
        sp=sub.add_parser(name)
        sp.add_argument("alvo", help="IP, SN, nome (aliasName) ou sufixo unico do SN/nome")
        sp.add_argument("--wait",type=int,default=API_WAIT,metavar="S",
                        help=f"segundos esperando o servico da TB subir (padrao {API_WAIT})")
        if name=="shell": sp.add_argument("command",nargs="?",default="sh")
    sub.add_parser("menu")
    a=ap.parse_args()
    if a.cmd in (None,"menu"): menu(); return
    if a.cmd=="list": cmd_list(a.deep); return
    reg=load_reg()
    if a.cmd in ("on","off"):
        ip=resolve_ip(a.alvo, reg)
        st=adb_set(ip,reg,on=(a.cmd=="on"),wait=a.wait); print(f"adb: {st}")
        if a.cmd=="on": do_connect(ip)
    elif a.cmd=="shell":
        ip=resolve_ip(a.alvo, reg)
        sn,d,tok=ensure_device(ip,reg,a.wait); login_pw=d.get("password",DEF_PASS)
        enable_ssh(ip,tok)
        pw=find_ssh_pw(ip,sn,reg,login_pw)
        sys.exit(ssh_interactive(ip, pw, None if a.command=="sh" else a.command))

if __name__=="__main__":
    try: main()
    except KeyboardInterrupt: print()
    except Exception as e:
        if os.environ.get("TB_ADB_DEBUG"): raise   # TB_ADB_DEBUG=1 mostra o traceback completo
        print(f"{C['r']}erro: {e}{C['n']}", file=sys.stderr); sys.exit(1)
